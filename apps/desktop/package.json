{
  "name": "@ai-manju/desktop",
  "version": "1.0.29",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "node ../../scripts/build-windows.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "build:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "electron-updater": "^6.8.9",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@prisma/client": "^5.19.0",
    "@vitejs/plugin-vue": "^5.1.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "prisma": "^5.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vue-tsc": "^2.1.4"
  },
  "build": {
    "appId": "com.aimanju.desktop",
    "productName": "AI视频工作台",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/python-win",
        "to": "python-win"
      },
      {
        "from": "resources/ai-service",
        "to": "ai-service"
      },
      {
        "from": "resources/seed-db",
        "to": "seed-db"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": null
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "AI-Manju-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AI-Manju-Setup-${version}.${ext}"
    },
    "electronVersion": "31.7.7",
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "AI-Manju-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.yesgangnam.com/aivideo/"
      }
    ],
    "afterSign": "notarize.js"
  }
}
